# Server Configuration
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://localhost:27017/kuwifr

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=7d

# Client URL
CLIENT_URL=http://localhost:5173

# Security
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100
# Optional: inbox that receives website Contact-form messages
# (falls back to EMAIL_FROM, then support@kuwifr.com). Messages are also
# always saved in Admin > Contact Messages.
# CONTACT_EMAIL_TO=support@kuwifr.com
